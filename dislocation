# Part 2 Dislocation

# Build splits for Bucketizer replicating R cut(..., right = FALSE)
# breaks = [-inf, -0.10, -0.075, ..., 0.25, inf]
seq_vals = [lower_bound + i * bin_step for i in range(int(round((upper_bound - lower_bound) / bin_step)) + 1)]
splits = [-float("inf")] + seq_vals + [float("inf")]

# Helper: build human-readable labels like "[-0.10, -0.075)"
labels = []
for i in range(len(splits) - 1):
    left = splits[i]
    right = splits[i + 1]
    # Match R 'right = FALSE' => intervals are [left, right)
    def fmt(x):
        if x == float("inf"): return "Inf"
        if x == -float("inf"): return "-Inf"
        return f"{x:.3f}".rstrip('0').rstrip('.') if '.' in f"{x:.3f}" else f"{x:.3f}"
    labels.append(f"[{fmt(left)}, {fmt(right)})")

labels = [lbl.replace(", ",",") for lbl in labels]


# -----------------------------------------------------------------------------
# Helpers
# -----------------------------------------------------------------------------
def add_rate_change_bucket(df, col_name="Rate_Change_Pc", out_col="Rate_Change_Level"):
    bucket_col = out_col + "_idx"

    bucketizer = Bucketizer(
        splits=splits,
        inputCol=col_name,
        outputCol=bucket_col
    )
    df_b = bucketizer.setHandleInvalid("keep").transform(df)

    labels_array = F.array(*[F.lit(l) for l in labels])

    df_1 = df_b.withColumn(
        out_col,
        F.when(
            F.col(bucket_col).isNull(),
            F.lit(labels[0])  # choose your null/default label
        ).otherwise(
            F.element_at(
                labels_array,
                F.col(bucket_col).cast("int") + F.lit(1)  # element_at is 1-based
            )
        )
    ).drop(bucket_col)

    return df_1



# 1) rat_km_annual_nb -> "0-5000", "5001-10000", ..., "20001+"
def km_annual_group(col):
    return (
        F.when(col <= 5000, F.lit("0-5000"))
         .when((col > 5000) & (col <= 10000), F.lit("5001-10000"))
         .when((col > 10000) & (col <= 15000), F.lit("10001-15000"))
         .when((col > 15000) & (col <= 20000), F.lit("15001-20000"))
         .when(col > 20000, F.lit("20001+"))
         .otherwise(F.lit(None))               # match R: keep NA as NA
    )

# 2) rat_km_work_nb -> "0", "1-5", "6-15", "16-30", "31+"
def km_work_group(col):
    return (
        F.when(col == 0, F.lit("0"))
         .when((col > 0) & (col <= 5),  F.lit("1-5"))
         .when((col > 5) & (col <= 15), F.lit("6-15"))
         .when((col > 15) & (col <= 30),F.lit("16-30"))
         .when(col > 30, F.lit("31+"))
         .otherwise(F.lit(None))               # NA stays NA
    )

# 3) rat_km_business_nb -> "0" / "1+"
def km_business_group(col):
    return F.when(col == 0, F.lit("0")).when(col > 0, F.lit("1+")).otherwise(F.lit(None))

# 4) number_veh_in_family -> cap at >8 -> ">8" else keep as string
def cap_gt8_as_str(col):
    return F.when(col > 8, F.lit(">8")).otherwise(col.cast("string"))

# 5) number_au_mh -> cap at >8 -> ">8" else keep as string
def cap_au_mh_as_str(col):
    return F.when(col > 8, F.lit(">8")).otherwise(col.cast("string"))

# 6) veh_dri_onp_nb -> cap at >4 -> ">4" else keep as string
def cap_onp_as_str(col):
    return F.when(col > 4, F.lit(">4")).otherwise(col.cast("string"))

# 7) NA fill for numerics (ifelse(is.na(x), default, x))
def nz_num(col, default):
    return F.coalesce(col, F.lit(default))

# 8) NA fill for strings (ifelse(is.na(x), default, x))
def nz_str(col, default="N"):
    return F.coalesce(col, F.lit(default))

# 9) veh_age_nb -> "10+" if > 10, otherwise keep numeric as string
def veh_age_bucket(col):
    return F.when(col > 10, F.lit("10+")).otherwise(col.cast("string"))

# 10) veh_vicc_price_am -> banding; NA or <=0 -> "Not Available"
def price_band(col):
    return (
        F.when((col > 0)    & (col < 10000),  F.lit("0-9999"))
         .when((col >= 10000) & (col < 15000), F.lit("10000-14999"))
         .when((col >= 15000) & (col < 20000), F.lit("15000-19999"))
