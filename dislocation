# 11) pol_uwcompany_cd -> map snic->SN, prim->PIC, else "TDHA"; keep NA as NA
def map_company(col):
    return (
        F.when(col == F.lit("snic"), F.lit("SN"))
         .when(col == F.lit("prim"), F.lit("PIC"))
         # for any other non-null code -> "TDHA"; if null -> null (like R ifelse with NA)
         .otherwise(F.when(col.isNull(), F.lit(None)).otherwise(F.lit("TDHA")))
    )

def nz(col):
    return F.coalesce(col, F.lit(0.0))

def coalesce_any(df, names):
    # returns F.coalesce of all candidates that exist; else F.lit(0.0)
    existing = [F.col(c) for c in names if c in df.columns]
    return F.coalesce(*existing) if existing else F.lit(0.0)
